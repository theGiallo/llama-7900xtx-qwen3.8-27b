         uint32_t n_rs_seq;              // number of recurrent-state snapshots per seq for rollback (0 = no rollback) [EXPERIMENTAL]
+        uint32_t n_ctx_reserve;         // cap (in KV cells) of the KV span assumed when reserving compute buffers (0 = full context).
