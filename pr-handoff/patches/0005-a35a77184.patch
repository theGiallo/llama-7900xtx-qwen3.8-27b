From a35a771843036825a8543f72cc9b20335a37cc0a Mon Sep 17 00:00:00 2001
From: Gianluca Alloisio <giallodue@gmail.com>
Date: Thu, 1 Oct 2026 11:22:48 +0200
Subject: [PATCH] Add --ctx-reserve (cap the KV span used to reserve compute
 buffers) and --spec-draft-ctx (smaller draft context with a sliding window)

Both default to 0 = unchanged behaviour. --ctx-reserve: the worst-case compute buffer of a long-context slot (f16 K/V conversion
workspace + mask) scales with n_ctx; with the cap it is sized for N cells and the scheduler grows it on demand.
--spec-draft-ctx: the MTP draft context holds N positions per sequence and drops older ones before each draft prefill batch.
---
 common/arg.cpp                 | 17 +++++++++++++++++
 common/common.cpp              |  1 +
 common/common.h                |  2 ++
 common/speculative.cpp         | 23 ++++++++++++++++++++++-
 include/llama.h                |  3 +++
 src/llama-context.cpp          |  5 +++++
 src/llama-cparams.h            |  1 +
 src/llama-kv-cache-iswa.h      |  2 ++
 src/llama-kv-cache.cpp         |  3 +++
 src/llama-kv-cache.h           |  6 ++++++
 src/llama-memory-hybrid-iswa.h |  2 ++
 src/llama-memory-hybrid.h      |  2 ++
 src/llama-memory.h             |  4 ++++
 13 files changed, 70 insertions(+), 1 deletion(-)

diff --git a/common/arg.cpp b/common/arg.cpp
index 63e342776..cf6fca8d8 100644
--- a/common/arg.cpp
+++ b/common/arg.cpp
@@ -1643,6 +1643,15 @@ common_params_context common_params_parser_init(common_params & params, llama_ex
             }
         }
     ).set_env("LLAMA_ARG_CTX_SIZE"));
+    add_opt(common_arg(
+        {"--ctx-reserve"}, "N",
+        "cap (in KV cells) of the KV span assumed when reserving compute buffers (default: 0 = full context).\n"
+        "on long contexts the worst-case compute buffers (f16 K/V conversion workspace, mask) scale with the context; with N set they\n"
+        "are sized for N cells and grow on demand if a batch needs more",
+        [](common_params & params, int value) {
+            params.n_ctx_reserve = value;
+        }
+    ).set_env("LLAMA_ARG_CTX_RESERVE").set_examples({LLAMA_EXAMPLE_SERVER, LLAMA_EXAMPLE_SPECULATIVE, LLAMA_EXAMPLE_CLI, LLAMA_EXAMPLE_COMPLETION}));
     add_opt(common_arg(
         { "--kv-unified-per-slot" }, "N",
         "context limit per parallel slot (default: unset, behavior unchanged).\n"
@@ -4082,6 +4091,14 @@ common_params_context common_params_parser_init(common_params & params, llama_ex
             params.speculative.draft.cpuparams_batch.poll = value;
         }
     ).set_spec().set_examples({LLAMA_EXAMPLE_SPECULATIVE, LLAMA_EXAMPLE_SERVER, LLAMA_EXAMPLE_CLI}));
+    add_opt(common_arg(
+        {"--spec-draft-ctx", "-cd", "--ctx-size-draft"}, "N",
+        "context size per sequence for the draft context (default: 0 = same as the target).\n"
+        "with a smaller value the draft KV keeps only the most recent positions (sliding window; MTP draft only)",
+        [](common_params & params, int value) {
+            params.speculative.draft.n_ctx = value;
+        }
+    ).set_env("LLAMA_ARG_SPEC_DRAFT_CTX").set_spec().set_examples({LLAMA_EXAMPLE_SPECULATIVE, LLAMA_EXAMPLE_SERVER, LLAMA_EXAMPLE_CLI}));
     add_opt(common_arg(
         {"--spec-draft-type-k", "-ctkd", "--cache-type-k-draft"}, "TYPE",
         string_format(
diff --git a/common/common.cpp b/common/common.cpp
